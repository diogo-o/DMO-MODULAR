@page "/controlo/approve/historico"
@model DMO.Web.Pages.Controlo.Approve.ApproveHistoricoModel
@using DMO.Web.Frontend.Shared.Contracts
@{
    ViewData["Title"] = "Histórico de Pesos";
}
<partial name="~/Pages/Shared/Components/_SharedComponentAssets.cshtml" />
<link rel="stylesheet" href="~/css/dmo-controlo-approve.css" asp-append-version="true" />
<script src="~/js/dmo-controlo-approve.js" defer></script>

@*
    P2-T06 Histórico de Pesos surface (contract §21.2 regions H1–H3, §20).

    HISTÓRICO (local) inside Controlo Approve — NOT HISTÓRICO GLOBAL (historia, DEFERRED BY
    DESIGN). Fixed desktop composition at the binding 1366 × 768 viewport (§21): H1–H3 keep their
    structural order at every desktop width; no breakpoint variant, no card conversion, no
    required-column hiding and no action relocation (AC-L1/L2).

    Every fact is a REAL backend fact: the rows carry the exact peso_id, the current status and
    the last decision summary (with the full decision/reopen trail preserved after reopen); every
    filter is backend-applied; single click selects and double click opens the exact record; the
    actions (Reabrir / Ver decisões) live OUTSIDE the table — no per-row action button grid
    exists (AC-H3). The detail (H3) is the same review sheet as the Aprovar surface.
*@
<section class="dmo-controlo-approve" data-dmo-approve-surface="historico" data-dmo-approve-root="true">

    @* ---- Secondary Controlo tabs (Histórico is the current tab; shared with Resumo) --------- *@
    <nav class="dmo-secondary-nav" aria-label="Áreas do Controlo" data-dmo-controlo-tabs="true">
        @foreach (var tab in Model.Tabs)
        {
            if (tab.IsCurrent)
            {
                <a href="@tab.Href" aria-current="page" data-dmo-controlo-tab="@tab.Key">@tab.Label</a>
            }
            else if (tab.IsAvailable)
            {
                <a href="@tab.Href" data-dmo-controlo-tab="@tab.Key">@tab.Label</a>
            }
            else
            {
                <span aria-disabled="true"
                      title="@tab.DisabledReason"
                      data-dmo-controlo-tab="@tab.Key"
                      data-dmo-controlo-tab-unavailable="@tab.DisabledReason">@tab.Label</span>
            }
        }
    </nav>

    @* ---- H1 — Filters (the §15.2 set; backend-applied) ------------------------------------ *@
    <div class="dmo-approve__region" data-dmo-approve-region="filters" aria-label="Filtros">
        <form class="dmo-approve__filters" method="get" action="/controlo/approve/historico" data-dmo-approve-filters="true">
            <label class="dmo-approve__label" for="dmo-historico-state">Estado</label>
            <select class="dmo-approve__input dmo-approve__input--select" id="dmo-historico-state" name="reviewState" data-dmo-filter-review-state="true">
                <option value="">Todos</option>
                <option value="pendente" selected="@(Model.ReviewState == "pendente")">Pendente (submetido, por decidir)</option>
                <option value="submetido" selected="@(Model.ReviewState == "submetido")">Submetido</option>
                <option value="aprovado" selected="@(Model.ReviewState == "aprovado")">Aprovado</option>
                <option value="nao_aprovado" selected="@(Model.ReviewState == "nao_aprovado")">Não aprovado</option>
            </select>
            <label class="dmo-approve__label" for="dmo-historico-reference">Referência</label>
            <input class="dmo-approve__input" id="dmo-historico-reference" name="reference" type="text"
                   value="@Model.Reference" data-dmo-filter-reference="true" />
            <label class="dmo-approve__label" for="dmo-historico-production">Produção</label>
            <input class="dmo-approve__input" id="dmo-historico-production" name="productionNumber" type="text"
                   value="@Model.ProductionNumber" data-dmo-filter-production="true" />
            <label class="dmo-approve__label" for="dmo-historico-machine">Máquina</label>
            <input class="dmo-approve__input" id="dmo-historico-machine" name="machine" type="text"
                   value="@Model.Machine" data-dmo-filter-machine="true" />
            <label class="dmo-approve__label" for="dmo-historico-processo">Processo</label>
            <input class="dmo-approve__input" id="dmo-historico-processo" name="processo" type="text"
                   value="@Model.Processo" data-dmo-filter-processo="true" />
            <label class="dmo-approve__label" for="dmo-historico-tool">Ferramenta</label>
            <input class="dmo-approve__input" id="dmo-historico-tool" name="toolReference" type="text"
                   value="@Model.ToolReference" data-dmo-filter-tool="true" />
            <label class="dmo-approve__label" for="dmo-historico-decision">Decisão</label>
            <select class="dmo-approve__input dmo-approve__input--select" id="dmo-historico-decision" name="decision" data-dmo-filter-decision="true">
                <option value="">Todas</option>
                <option value="aprovado" selected="@(Model.Decision == "aprovado")">Aprovado</option>
                <option value="nao_aprovado" selected="@(Model.Decision == "nao_aprovado")">Não aprovado</option>
                <option value="reaberto" selected="@(Model.Decision == "reaberto")">Reaberto</option>
            </select>
            <button class="dmo-approve__button" type="submit" data-dmo-approve-filter-submit="true">Filtrar</button>
        </form>

        @if (Model.ValidationErrors.Count > 0)
        {
            <ul class="dmo-approve__errors" role="alert" data-dmo-approve-errors="true">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li data-dmo-approve-error="@error">@error</li>
                }
            </ul>
        }
    </div>

    @* ---- H2 — History table (selection + open arbitration; actions outside the table) ----- *@
    <div class="dmo-approve__region" data-dmo-approve-region="history" aria-label="Histórico de Pesos">
        @if (Model.History is { } history)
        {
            <div class="dmo-approve__route-map" data-dmo-open-route-map="true" hidden>
                @foreach (var route in Model.OpenRoutes)
                {
                    <span data-dmo-open-route="@route.Key" data-dmo-open-href="@route.Href"></span>
                }
            </div>
            <partial name="~/Pages/Shared/Components/_DenseDataTable.cshtml" model="history" />
        }
        else if (Model.ValidationErrors.Count == 0)
        {
            <p class="dmo-approve__pending-empty" data-dmo-history-empty="true">Sem registos no Histórico de Pesos.</p>
        }
    </div>

    @if (Model.Sheet is { } sheet)
    {
        @* ---- H3 — Detail: the exact record's review sheet (R3 content) + full trail (R5) --- *@
        <div class="dmo-approve__region" data-dmo-approve-region="detail" aria-label="Detalhe do Peso"
             data-dmo-peso-id="@sheet.Peso.PesoId" data-dmo-review-status="@sheet.Peso.Status">

            <div class="dmo-approve__strip" data-dmo-controlo-strip="true" aria-label="Contexto da produção">
                @if (sheet.Peso.Production is { } production)
                {
                    <dl class="dmo-approve__strip-facts">
                        <div class="dmo-approve__strip-fact"><dt>Referência</dt><dd data-dmo-strip-reference="true">@production.Reference</dd></div>
                        <div class="dmo-approve__strip-fact"><dt>Produção</dt><dd data-dmo-strip-production="true">@production.ProductionNumber</dd></div>
                        <div class="dmo-approve__strip-fact"><dt>Máquina</dt><dd data-dmo-strip-machine="true">@production.Machine</dd></div>
                    </dl>
                }
                else
                {
                    <p class="dmo-approve__strip-empty" data-dmo-strip-empty="true">Job On por associar — Peso ancorado à ferramenta CM selecionada.</p>
                }
            </div>

            @if (sheet.Peso.Context is { } context)
            {
                <dl class="dmo-approve__frozen-triple" data-dmo-frozen-triple="true">
                    <div class="dmo-approve__strip-fact"><dt>Ferramenta CM (fixada)</dt><dd>@context.FrozenToolReference — lote @context.FrozenToolLot</dd></div>
                </dl>
            }
            else if (sheet.Peso.Pending is { } pending)
            {
                <div class="dmo-approve__pending-context" data-dmo-pending-context="true">
                    <strong>Job On por associar</strong>
                    <span data-dmo-pending-tool-reference="true">Ferramenta: @pending.Tool.Reference — lote @pending.Tool.Lot</span>
                </div>
            }

            <dl class="dmo-approve__facts">
                <div class="dmo-approve__fact"><dt>Temperatura da água (°C)</dt><dd data-dmo-field-temperature="true">@sheet.Peso.WaterTemperature.ToString("0.0")</dd></div>
                <div class="dmo-approve__fact"><dt>Volume Marisa/BQ (cm³)</dt><dd data-dmo-field-marisa="true">@(sheet.Peso.VolumeMarisaBq?.ToString("0.####") ?? "—")</dd></div>
                <div class="dmo-approve__fact"><dt>Volume Punção/PU (cm³)</dt><dd data-dmo-field-puncao="true">@(sheet.Peso.VolumePuncaoPu?.ToString("0.####") ?? "—")</dd></div>
                <div class="dmo-approve__fact"><dt>Fim da produção anterior (SAP)</dt><dd data-dmo-field-sap-end="true">@(sheet.Peso.PreviousProductionEndReference ?? "—")</dd></div>
                <div class="dmo-approve__fact"><dt>Peso médio anterior (SAP)</dt><dd data-dmo-field-sap-weight="true">@(sheet.Peso.PreviousAverageWeightReference ?? "—")</dd></div>
                <div class="dmo-approve__fact"><dt>Submetido em</dt><dd data-dmo-submitted-at="true">@(sheet.Peso.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
            </dl>

            <div class="dmo-approve__results-scroll" role="region" tabindex="0" aria-label="Resultados por leitura">
                <table class="dmo-approve__results-table" data-dmo-results-table="true">
                    <thead>
                        <tr>
                            <th>Leitura</th>
                            <th>Peso em água (g)</th>
                            <th>Capacidade (cm³)</th>
                            <th>Peso do vidro (g)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in sheet.Peso.Rows)
                        {
                            <tr data-dmo-result-row="@row.RowPosition">
                                <td>@row.RowPosition</td>
                                <td>@row.WaterWeightG.ToString("0.##")</td>
                                <td data-dmo-result-capacity="@row.RowPosition">@row.CapacityCm3.ToString("0.##")</td>
                                <td data-dmo-result-glass="@row.RowPosition">@row.GlassWeightG.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <dl class="dmo-approve__summary" data-dmo-results-summary="true">
                <div class="dmo-approve__fact"><dt>Densidade usada</dt><dd data-dmo-summary-density="true">@(sheet.Peso.GlassDensityGCm3?.ToString("0.####") ?? "—")</dd></div>
            </dl>

            @* Decision region (outside the table — against the opened/selected record) *@
            <div class="dmo-approve__region" data-dmo-approve-region="detail-actions" aria-label="Decisão">
                @if (Model.Actions is { } actions)
                {
                    ViewData["DecisionBarRegionId"] = "dmo-approve-detail-actions";
                    <partial name="~/Pages/Shared/Components/_DecisionBar.cshtml" model="actions" />
                }

                <div class="dmo-approve__reason" data-dmo-reason-region="true" hidden>
                    <label class="dmo-approve__label" for="dmo-approve-reason">Motivo (obrigatório)</label>
                    <input class="dmo-approve__input" id="dmo-approve-reason" type="text" data-dmo-reason-input="true" maxlength="2000" />
                </div>

                @if (Model.Send is { } send)
                {
                    <button type="button"
                            class="dmo-approve__send"
                            data-dmo-send-affordance="true"
                            disabled
                            aria-disabled="true"
                            aria-describedby="dmo-approve-detail-send-reason"
                            data-dmo-send-reason="@send.Reason">Enviar para produção</button>
                    <span class="dmo-approve__action-reason" id="dmo-approve-detail-send-reason" data-dmo-send-reason-text="true">@send.Reason</span>
                }

                <div class="dmo-approve__state" data-dmo-approve-state="true" hidden></div>
            </div>

            @* Full decision/reopen trail (append-only; preserved after reopen) *@
            <div class="dmo-approve__region" data-dmo-approve-region="detail-trail" aria-label="Decisões">
                @if (Model.Trail is { } trail)
                {
                    <partial name="~/Pages/Shared/Components/_AuditTrail.cshtml" model="trail" />
                }
            </div>

            <div class="dmo-approve__adapter-state" hidden
                 data-dmo-peso-id="@(Model.Sheet.Peso.PesoId)"
                 data-dmo-version="@Model.ObservedVersion"></div>
        </div>
    }
</section>